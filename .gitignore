# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
PhysicsShooter/SourceArt/**/*.png
PhysicsShooter/SourceArt/**/*.tga

# Binary Files
PhysicsShooter/Binaries/*
PhysicsShooter/Plugins/**/Binaries/*

# Builds
PhysicsShooter/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!PhysicsShooter/Build/*/
PhysicsShooter/Build/*/**
!PhysicsShooter/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!PhysicsShooter/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
PhysicsShooter/Saved/*

# Compiled source files for the engine to use
PhysicsShooter/Intermediate/*
PhysicsShooter/Plugins/**/Intermediate/*

# Cache files for the editor to use
PhysicsShooter/DerivedDataCache/*
